# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security
SECRET_KEY=your-secret-key-change-in-production

# Model Paths
RKNN_MODEL_PATH=./rknn/Version6.rknn
ONNX_MODEL_PATH=./onnx/model.onnx

# Inference Settings
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
IMG_SIZE=320

# ESP32 WebSocket Configuration
ESP32_WS_URI=ws://10.28.26.7:81/
WS_RECONNECT_DELAY=2
WS_MAX_SIZE=None

# Logging
LOG_LEVEL=INFO
